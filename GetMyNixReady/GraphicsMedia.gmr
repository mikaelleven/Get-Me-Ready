# name: Graphics & Media
# sortindex: 300

"VLC" : > vlc
"Audacity" : > audacity
"FileZilla" : $> sudo apt install filezilla
"HandBrake" : $> sudo apt install handbrake
"7-Zip" : $> sudo apt install p7zip-full
"VeraCrypt" : $> sudo apt install veracrypt
"GIMP" : > gimp
"Blender" : > blender
"FreeCAD" : > freecad
"KiCad" : > kicad
"f.lux" : $> sudo apt install fluxgui
"Spotify" : $> sudo apt install spotify-client
"Discord" : $> sudo apt install discord
"Balena Etcher" : > balena-etcher
"Slack" : $> sudo apt install slack-desktop
"Dropbox" : $> sudo apt install nautilus-dropbox
"Google Drive" : $> sudo apt install google-drive-ocamlfuse
"OneDrive" : $> sudo apt install onedrive
"VMware Player" : > https://www.vmware.com/products/desktop-hypervisor/workstation-and-fusion
"LocalSend" : > localsend
"PDFgear" : > https://www.pdfgear.com/linux/
