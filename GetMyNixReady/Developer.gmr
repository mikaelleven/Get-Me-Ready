# name: Developer
# sortindex: 400

!"Git" : > git
?"Neovim" : $> sudo apt install neovim
?"LazyVim" : > https://www.lazyvim.org/installation
"Node.js" : > nodejs
?"Lua" : > lua5.4
?"OpenCode" : $> curl -fsSL https://opencode.ai/install | bash
?"Codex CLI" : $> npm install --global @openai/codex
"GitHub CLI" : $> sudo apt install gh
"Antigravity 2.0" : $> ./Installers/Install-Antigravity.sh
"Antigravity CLI" : $> curl -fsSL https://antigravity.google/cli/install.sh | bash
? "Antigravity IDE" : $> ./Installers/Install-AntigravityIDE.sh
